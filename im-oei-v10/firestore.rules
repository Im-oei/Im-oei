rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── COMMON FUNCTIONS ─────────────────────────────────────────────────────

    function isLoggedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isLoggedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidPhone(phone) {
      return phone is string && phone.matches('^0[0-9]{9}$');
    }

    // ─── ORDERS ───────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      // รองรับทั้ง customerPhone (เดิม) และ lineUserId / guestId (ใหม่)
      allow create: if request.resource.data.keys().hasAny(['customerPhone','lineUserId','guestId'])
        && request.resource.data.keys().hasAll(['items','total','status','createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0;

      allow read: if isAdmin() || true;
      allow update, delete: if isAdmin();
    }

    // ─── MENU ─────────────────────────────────────────────────────────────────
    match /menu/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── CATEGORIES ───────────────────────────────────────────────────────────
    match /categories/{catId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── BANNERS ──────────────────────────────────────────────────────────────
    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── SETTINGS ─────────────────────────────────────────────────────────────
    match /settings/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── PUSH QUEUE ───────────────────────────────────────────────────────────
    match /pushQueue/{docId} {
      allow read, write: if isAdmin();
    }

    // ─── LINE QUEUE ───────────────────────────────────────────────────────────
    match /lineQueue/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ─── RATINGS ──────────────────────────────────────────────────────────────
    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && request.resource.data.keys().hasAll(['orderId','itemId','star','createdAt'])
        && request.resource.data.star is int
        && request.resource.data.star >= 1
        && request.resource.data.star <= 5;
      allow update, delete: if isAdmin();
    }

    // ─── CUSTOMERS ────────────────────────────────────────────────────────────
    // รองรับ 3 รูปแบบ ID: "phone_XXXXXXXXXX" | "line_XXXXXXXXXX" | "guest_XXXXXXXXXX"
    match /customers/{customerId} {
      allow read: if isAdmin();
      allow create: if true; // เปิดให้ทุกคน create ได้ (guest, LINE, phone)
      allow update: if isAdmin()
        || (customerId == ('line_' + request.resource.data.lineUserId))
        || (customerId.matches('^guest_.*'));
      allow delete: if isAdmin();
    }

    // ─── PICKUP LOCATIONS ─────────────────────────────────────────────────────
    match /pickupLocations/{locId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── LINE USERS ───────────────────────────────────────────────────────────
    match /lineUsers/{userId} {
      allow read: if isAdmin() || isLoggedIn();
      // ไม่ต้องการ phone แล้ว — เขียนได้เฉพาะ doc ของตัวเอง (userId == doc key)
      allow write: if isLoggedIn()
        && request.resource.data.userId == userId;
    }

    // ─── LINE PHONE MAP (legacy — ยังคงไว้เผื่อข้อมูลเก่า) ────────────────
    match /linePhoneMap/{phone} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ─── ADMINS ───────────────────────────────────────────────────────────────
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ─── REWARDS CATALOG ──────────────────────────────────────────────────────
    match /rewards/{rewardId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── REWARD REDEMPTIONS ───────────────────────────────────────────────────
    match /rewardRedemptions/{docId} {
      allow read: if isAdmin();
      // รองรับ lineUserId แทน phone
      allow create: if (request.resource.data.keys().hasAll(['phone','rewardId','createdAt'])
          && isValidPhone(request.resource.data.phone))
        || (request.resource.data.keys().hasAll(['lineUserId','rewardId','createdAt'])
          && request.resource.data.lineUserId is string);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ─── STAMPS ───────────────────────────────────────────────────────────────
    // รองรับทั้ง phone (เดิม) และ lineUserId (ใหม่)
    match /stamps/{customerId} {
      allow read: if isAdmin()
        || (isLoggedIn()
            && (exists(/databases/$(database)/documents/customers/$('line_' + customerId))
                || exists(/databases/$(database)/documents/customers/$('phone_' + customerId))));
      allow create, update, delete: if false; // Cloud Function only
    }

    // ─── PUSH SUBSCRIPTIONS ───────────────────────────────────────────────────
    match /pushSubscriptions/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        || request.resource.data.keys().hasAll(['endpoint','createdAt']);
      allow delete: if isAdmin();
    }

    // ─── INTERNAL ─────────────────────────────────────────────────────────────
    match /rateLimits/{docId} {
      allow read, write: if false;
    }
    match /stats_daily/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /stats_menu/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 🚫 ปิดทุกอย่างที่ไม่ได้กำหนด
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
