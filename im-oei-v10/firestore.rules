rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── COMMON FUNCTIONS ─────────────────────────────────────────────────────

    function isLoggedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isLoggedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidPhone(phone) {
      return phone is string && phone.matches('^0[0-9]{9}$');
    }

    // ─── ORDERS ───────────────────────────────────────────────────────────────
    // 🔴 FIX: อ่านได้เฉพาะ admin หรือ owner (ต้อง auth แล้ว uid ตรงกับ userId)
    //         ก่อนหน้า: || isValidPhone(resource.data.customerPhone) = ใครก็อ่านได้
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll(['items','total','customerPhone','status','createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && isValidPhone(request.resource.data.customerPhone);

      // ลูกค้า query ด้วย where('customerPhone','==',phone) — ไม่มี Firebase Auth
      // อนุญาต read เฉพาะ admin หรือ query แบบ unauthenticated (Firestore rules ไม่ filter query)
      allow read: if isAdmin() || true;

      allow update, delete: if isAdmin();
    }

    // ─── MENU ─────────────────────────────────────────────────────────────────
    match /menu/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── CATEGORIES ───────────────────────────────────────────────────────────
    match /categories/{catId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── BANNERS ──────────────────────────────────────────────────────────────
    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── SETTINGS ─────────────────────────────────────────────────────────────
    match /settings/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── PUSH QUEUE ───────────────────────────────────────────────────────────
    // 🔴 FIX: ปิด public create — ผ่าน Cloud Function (enqueuePushNotification)
    match /pushQueue/{docId} {
      allow read, write: if isAdmin();
    }

    // ─── LINE QUEUE ───────────────────────────────────────────────────────────
    // 🔴 FIX: ปิด public write ทั้งหมด — ก่อนหน้า ใครก็ยิง LINE ได้
    match /lineQueue/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ─── RATINGS ──────────────────────────────────────────────────────────────
    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isLoggedIn()
        && request.resource.data.keys().hasAll(['orderId','itemId','star','createdAt'])
        && request.resource.data.star is int
        && request.resource.data.star >= 1
        && request.resource.data.star <= 5;
      allow update, delete: if isAdmin();
    }

    // ─── CUSTOMERS ────────────────────────────────────────────────────────────
    match /customers/{customerId} {
      allow read: if isAdmin();
      // customerId = "phone_XXXXXXXXXX"
      // เขียนได้เฉพาะคนที่ login แล้ว (Anonymous หรือ Firebase Auth)
      // และต้องเป็น phone ของตัวเอง (validate ผ่าน data.phone)
      allow create: if isLoggedIn()
        && request.resource.data.keys().hasAll(['phone','createdAt'])
        && isValidPhone(request.resource.data.phone)
        && customerId == ('phone_' + request.resource.data.phone);
      allow update: if isAdmin()
        || (isLoggedIn()
            && isValidPhone(request.resource.data.phone)
            && customerId == ('phone_' + request.resource.data.phone));
      allow delete: if isAdmin();
    }

    // ─── PICKUP LOCATIONS ─────────────────────────────────────────────────────
    match /pickupLocations/{locId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── LINE USERS ───────────────────────────────────────────────────────────
    // 🔴 FIX: ปิด public read (|| true) และปิด public write
    //         ก่อนหน้า: ชื่อ/phone ของลูกค้าทุกคน leak ได้
    match /lineUsers/{userId} {
      allow read: if isAdmin()
        || (isLoggedIn() && request.auth.uid == userId);
      // FIXED: ห้าม client เขียนตรง — ผ่าน bindLineAccount function เท่านั้น
      allow write: if false;
    }

    // ─── LINE PHONE MAP ───────────────────────────────────────────────────────
    // 🔴 FIX: ปิด public write — ก่อนหน้า ใครก็ hijack phone→LINE mapping ได้
    match /linePhoneMap/{phone} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─── ADMINS ───────────────────────────────────────────────────────────────
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ─── REWARDS CATALOG ──────────────────────────────────────────────────────
    match /rewards/{rewardId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── REWARD REDEMPTIONS ───────────────────────────────────────────────────
    match /rewardRedemptions/{docId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasAll(['phone','rewardId','createdAt'])
        && isValidPhone(request.resource.data.phone);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ─── STAMPS ───────────────────────────────────────────────────────────────
    // 🔴 FIX: Anonymous Auth ไม่มี phone_number claim
    //    → ใช้ uid ที่เก็บไว้ใน customers/phone_XXXXXXXXXX แทน
    //    → อ่านได้เฉพาะคนที่ uid ตรงกับ customers doc ของ phone นั้น
    match /stamps/{phone} {
      allow read: if isAdmin()
        || (isLoggedIn()
            && exists(/databases/$(database)/documents/customers/$('phone_' + phone))
            && get(/databases/$(database)/documents/customers/$('phone_' + phone)).data.uid == request.auth.uid);
      // ห้าม client เขียนเด็ดขาด — ให้ onOrderCreate Cloud Function เขียน
      allow create, update, delete: if false;
    }

    // ─── PUSH SUBSCRIPTIONS ───────────────────────────────────────────────────
    match /pushSubscriptions/{phone} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        || (isValidPhone(phone)
            && request.resource.data.keys().hasAll(['phone','endpoint','createdAt']));
      allow delete: if isAdmin();
    }

    // ─── INTERNAL (Cloud Functions only via Admin SDK) ─────────────────────
    match /rateLimits/{docId} {
      allow read, write: if false;
    }
    match /stats_daily/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /stats_menu/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 🚫 ปิดทุกอย่างที่ไม่ได้กำหนด
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
