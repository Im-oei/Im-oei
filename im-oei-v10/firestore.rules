rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasTenantAccess(tenantId) {
      return isSignedIn() && request.auth.token.tenantId == tenantId;
    }

    function isRole(role) {
      return isSignedIn() && request.auth.token.role == role;
    }

    match /tenants/{tenantId} {
      allow read: if hasTenantAccess(tenantId);
      allow write: if isRole('superadmin');
    }

    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isRole('cashier') || isRole('manager');
      allow delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isRole('manager') || isRole('superadmin');
      allow write: if false;
    }
  }
}
