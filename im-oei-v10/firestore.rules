rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── FUNCTIONS ────────────────────────────────────────────────────────────
    function isFirebaseAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidPhone(phone) {
      return phone is string && phone.matches('^0[0-9]{9}$');
    }

    // ─── ORDERS ───────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAny(['customerPhone','lineUserId','guestId'])
        && request.resource.data.keys().hasAll(['items','total','status','createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0;
      allow update: if true;
      allow delete: if isFirebaseAdmin();
    }

    // ─── MENU ─────────────────────────────────────────────────────────────────
    match /menu/{itemId} {
      allow read: if true;
      allow create, update, delete: if isFirebaseAdmin();
    }

    // ─── CATEGORIES ───────────────────────────────────────────────────────────
    match /categories/{catId} {
      allow read: if true;
      allow create, update, delete: if isFirebaseAdmin();
    }

    // ─── BANNERS ──────────────────────────────────────────────────────────────
    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isFirebaseAdmin();
    }

    // ─── SETTINGS ─────────────────────────────────────────────────────────────
    match /settings/auth {
      allow read: if isFirebaseAdmin();
      allow create, update, delete: if isFirebaseAdmin();
    }
    match /settings/{docId} {
      allow read: if true;
      allow create, update, delete: if isFirebaseAdmin();
    }

    // ─── ADMINS ───────────────────────────────────────────────────────────────
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ─── CUSTOMERS ────────────────────────────────────────────────────────────
    match /customers/{customerId} {
      // อ่าน: admin หรือเจ้าของ (phone/lineId/guestId)
      allow read: if isFirebaseAdmin()
        || (request.auth != null && request.auth.token.phone_number == customerId)
        || (request.auth != null && request.auth.uid == customerId)
        || customerId.matches('^guest_.*')
        || customerId.matches('^line_.*');

      // สร้าง: phone customer (มี phone field ถูกต้อง), LINE user (line_xxx), guest (guest_xxx)
      allow create: if (
          // Phone customer
          request.resource.data.keys().hasAll(['phone'])
          && isValidPhone(request.resource.data.phone)
          && request.resource.data.phone == customerId
        ) || (
          // LINE user — customerId ขึ้นต้นด้วย line_ และมี lineId field
          customerId.matches('^line_.*')
          && request.resource.data.keys().hasAny(['lineId', 'source'])
        ) || (
          // Guest user — customerId ขึ้นต้นด้วย guest_
          customerId.matches('^guest_.*')
          && request.resource.data.keys().hasAny(['guestId', 'source'])
        );

      // อัปเดต: admin, เจ้าของ phone, LINE user เจ้าของตัวเอง, guest
      allow update: if isFirebaseAdmin()
        || (request.auth != null && request.auth.token.phone_number == customerId)
        || (request.auth != null && request.auth.uid == customerId)
        || customerId.matches('^line_.*')
        || customerId.matches('^guest_.*');

      allow delete: if isFirebaseAdmin();
    }

    // ─── STAMPS ───────────────────────────────────────────────────────────────
    match /stamps/{customerId} {
      // อ่านได้เลย — เบอร์/lineUserId ไม่ใช่ข้อมูลลับ และลูกค้า LINE ไม่มี Firebase Auth
      allow read: if true;
      allow create, update: if true;
      allow delete: if isFirebaseAdmin();
    }

    // ─── RATINGS ──────────────────────────────────────────────────────────────
    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['orderId','itemId','star','createdAt'])
        && request.resource.data.star is int
        && request.resource.data.star >= 1
        && request.resource.data.star <= 5;
      allow update: if isFirebaseAdmin();
      allow delete: if isFirebaseAdmin();
    }

    // ─── REWARDS CATALOG ──────────────────────────────────────────────────────
    match /rewards/{rewardId} {
      allow read: if true;
      allow create, update, delete: if isFirebaseAdmin();
    }

    // ─── REWARD REDEMPTIONS ───────────────────────────────────────────────────
    match /rewardRedemptions/{docId} {
      allow read: if isFirebaseAdmin()
        || (request.auth != null
          && request.auth.token.phone_number != null
          && resource.data.phone == request.auth.token.phone_number)
        || (request.auth != null
          && request.auth.uid != null
          && resource.data.lineUserId == request.auth.uid);
      allow create: if true;
      allow update: if isFirebaseAdmin();
      allow delete: if false;
    }

    // ─── PICKUP LOCATIONS ─────────────────────────────────────────────────────
    match /pickupLocations/{locId} {
      allow read: if true;
      allow create, update, delete: if isFirebaseAdmin();
    }

    // ─── LINE USERS ───────────────────────────────────────────────────────────
    match /lineUsers/{userId} {
      // อ่านได้ทุกคน (ลูกค้า LINE ไม่มี Firebase Auth)
      allow read: if true;
      // เขียนได้ทุกคน — LINE userId เป็น public identifier ไม่มีข้อมูลลับ
      allow write: if true;
    }

    // ─── LINE PHONE MAP ───────────────────────────────────────────────────────
    match /linePhoneMap/{phone} {
      allow read: if isFirebaseAdmin();
      allow write: if true;
    }

    // ─── PUSH SUBSCRIPTIONS ───────────────────────────────────────────────────
    match /pushSubscriptions/{id} {
      allow read: if isFirebaseAdmin();
      allow create, update: if true;
      allow delete: if isFirebaseAdmin();
    }

    // ─── PUSH QUEUE ───────────────────────────────────────────────────────────
    match /pushQueue/{docId} {
      allow read: if isFirebaseAdmin();
      allow write: if false;
    }

    // ─── PUSH JOBS (Phase 4) — admin เขียน, Cloud Function อ่าน/อัปเดต ─────
    match /pushJobs/{jobId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['orderId','status','title','body','createdAt','done'])
        && request.resource.data.done == false;
      allow read, update: if isFirebaseAdmin();
      allow delete: if isFirebaseAdmin();
    }

    // ─── LINE QUEUE ───────────────────────────────────────────────────────────
    match /lineQueue/{docId} {
      allow read: if isFirebaseAdmin();
      allow write: if true;
    }

    // ─── INTERNAL — server-only ───────────────────────────────────────────────
    match /rateLimits/{docId} {
      allow read, write: if false;
    }
    match /stats_daily/{docId} {
      allow read: if isFirebaseAdmin();
      allow write: if false;
    }
    match /stats_menu/{docId} {
      allow read: if isFirebaseAdmin();
      allow write: if false;
    }

    // 🚫 ปิดทุกอย่างที่ไม่ได้กำหนด
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Coupons (Phase 3) ──
    match /coupons/{code} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'owner'];
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount']);
    }
  }
}
