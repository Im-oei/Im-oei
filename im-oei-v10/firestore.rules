rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── COMMON FUNCTIONS ─────────────────────────────────────────────────────

    // Firebase Auth (ใช้โดย admin email login)
    function isLoggedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isLoggedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidPhone(phone) {
      return phone is string && phone.matches('^0[0-9]{9}$');
    }

    // ─── ORDERS ───────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      // ลูกค้าสร้างออเดอร์ได้ (phone / LINE / guest)
      allow create: if request.resource.data.keys().hasAny(['customerPhone','lineUserId','guestId'])
        && request.resource.data.keys().hasAll(['items','total','status','createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0;

      // อ่านได้ทุกคน (ลูกค้าดูออเดอร์ตัวเอง)
      allow read: if true;

      // แก้ไข/ลบ — admin เท่านั้น
      allow update, delete: if isAdmin();
    }

    // ─── MENU ─────────────────────────────────────────────────────────────────
    match /menu/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── CATEGORIES ───────────────────────────────────────────────────────────
    match /categories/{catId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── BANNERS ──────────────────────────────────────────────────────────────
    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── SETTINGS ─────────────────────────────────────────────────────────────
    match /settings/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── ADMINS ───────────────────────────────────────────────────────────────
    // อ่านได้ทุกคน เพื่อให้ LIFF login ตรวจ role ได้
    // Document ID คือ line_XXXXXXXX ซึ่งเดาไม่ได้จากภายนอก
    // write ได้แค่ใน Firebase Console เท่านั้น
    match /admins/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // ─── CUSTOMERS ────────────────────────────────────────────────────────────
    match /customers/{customerId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update: if isAdmin()
        || (customerId == ('line_' + request.resource.data.lineUserId))
        || customerId.matches('^guest_.*');
      allow delete: if isAdmin();
    }

    // ─── STAMPS ───────────────────────────────────────────────────────────────
    match /stamps/{customerId} {
      // ลูกค้าอ่านแต้มตัวเองได้
      allow read: if true;
      // เขียนได้เฉพาะ server (Cloud Function) หรือ admin
      allow create, update, delete: if isAdmin();
    }

    // ─── RATINGS ──────────────────────────────────────────────────────────────
    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['orderId','itemId','star','createdAt'])
        && request.resource.data.star is int
        && request.resource.data.star >= 1
        && request.resource.data.star <= 5;
      allow update, delete: if isAdmin();
    }

    // ─── REWARDS CATALOG ──────────────────────────────────────────────────────
    match /rewards/{rewardId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── REWARD REDEMPTIONS ───────────────────────────────────────────────────
    match /rewardRedemptions/{docId} {
      allow read: if isAdmin();
      allow create: if (request.resource.data.keys().hasAll(['phone','rewardId','createdAt'])
            && isValidPhone(request.resource.data.phone))
          || (request.resource.data.keys().hasAll(['lineUserId','rewardId','createdAt'])
            && request.resource.data.lineUserId is string);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ─── PICKUP LOCATIONS ─────────────────────────────────────────────────────
    match /pickupLocations/{locId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── LINE USERS ───────────────────────────────────────────────────────────
    match /lineUsers/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // ─── PUSH SUBSCRIPTIONS ───────────────────────────────────────────────────
    match /pushSubscriptions/{id} {
      allow read: if isAdmin();
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // ─── PUSH / LINE QUEUE ────────────────────────────────────────────────────
    match /pushQueue/{docId} {
      allow read, write: if isAdmin();
    }
    match /lineQueue/{docId} {
      allow read, write: if isAdmin();
    }

    // ─── INTERNAL (read-only สำหรับ admin) ───────────────────────────────────
    match /rateLimits/{docId} {
      allow read, write: if false;
    }
    match /stats_daily/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /stats_menu/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─── LEGACY ───────────────────────────────────────────────────────────────
    match /linePhoneMap/{phone} {
      allow read, write: if isAdmin();
    }

    // 🚫 ปิดทุกอย่างที่ไม่ได้กำหนด
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
