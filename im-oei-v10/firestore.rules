rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── FUNCTIONS ────────────────────────────────────────────────────────────
    function isFirebaseAdmin() {
      // Email/password admin ที่ login ผ่าน Firebase Auth
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidPhone(phone) {
      return phone is string && phone.matches('^0[0-9]{9}$');
    }

    // ─── ORDERS ───────────────────────────────────────────────────────────────
    // อ่าน/เขียนได้ทุกคน (admin ตรวจสอบฝั่ง JS + session)
    // LINE admin ไม่มี Firebase Auth token → ต้องเปิดไว้
    match /orders/{orderId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAny(['customerPhone','lineUserId','guestId'])
        && request.resource.data.keys().hasAll(['items','total','status','createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0;
      allow update: if true;  // admin LINE ไม่มี auth token
      allow delete: if isFirebaseAdmin();
    }

    // ─── MENU ─────────────────────────────────────────────────────────────────
    match /menu/{itemId} {
      allow read: if true;
      allow create, update, delete: if true; // LINE admin ต้องการ
    }

    // ─── CATEGORIES ───────────────────────────────────────────────────────────
    match /categories/{catId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // ─── BANNERS ──────────────────────────────────────────────────────────────
    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // ─── SETTINGS ─────────────────────────────────────────────────────────────
    match /settings/{docId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // ─── ADMINS ───────────────────────────────────────────────────────────────
    // อ่านได้ทุกคน (LIFF ตรวจ role), เขียนได้แค่ Firebase Console
    match /admins/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // ─── CUSTOMERS ────────────────────────────────────────────────────────────
    match /customers/{customerId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isFirebaseAdmin();
    }

    // ─── STAMPS ───────────────────────────────────────────────────────────────
    match /stamps/{customerId} {
      allow read: if true;
      allow create, update: if true; // admin LINE อัพแต้มได้
      allow delete: if isFirebaseAdmin();
    }

    // ─── RATINGS ──────────────────────────────────────────────────────────────
    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['orderId','itemId','star','createdAt'])
        && request.resource.data.star is int
        && request.resource.data.star >= 1
        && request.resource.data.star <= 5;
      allow update, delete: if true;
    }

    // ─── REWARDS CATALOG ──────────────────────────────────────────────────────
    match /rewards/{rewardId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // ─── REWARD REDEMPTIONS ───────────────────────────────────────────────────
    match /rewardRedemptions/{docId} {
      allow read: if true;
      allow create: if (request.resource.data.keys().hasAll(['phone','rewardId','createdAt'])
            && isValidPhone(request.resource.data.phone))
          || (request.resource.data.keys().hasAll(['lineUserId','rewardId','createdAt'])
            && request.resource.data.lineUserId is string);
      allow update: if true;
      allow delete: if false;
    }

    // ─── PICKUP LOCATIONS ─────────────────────────────────────────────────────
    match /pickupLocations/{locId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // ─── LINE USERS ───────────────────────────────────────────────────────────
    match /lineUsers/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // ─── PUSH SUBSCRIPTIONS ───────────────────────────────────────────────────
    match /pushSubscriptions/{id} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isFirebaseAdmin();
    }

    // ─── PUSH / LINE QUEUE ────────────────────────────────────────────────────
    match /pushQueue/{docId} {
      allow read, write: if true;
    }
    match /lineQueue/{docId} {
      allow read, write: if true;
    }

    // ─── INTERNAL ─────────────────────────────────────────────────────────────
    match /rateLimits/{docId} {
      allow read, write: if false;
    }
    match /stats_daily/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /stats_menu/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // ─── LEGACY ───────────────────────────────────────────────────────────────
    match /linePhoneMap/{phone} {
      allow read, write: if true;
    }

    // 🚫 ปิดทุกอย่างที่ไม่ได้กำหนด
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
