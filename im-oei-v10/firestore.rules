rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── FUNCTIONS ────────────────────────────────────────────────────────────
    function isFirebaseAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidPhone(phone) {
      return phone is string && phone.matches('^0[0-9]{9}$');
    }

    // ─── ORDERS ───────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAny(['customerPhone','lineUserId','guestId'])
        && request.resource.data.keys().hasAll(['items','total','status','createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0;
      allow update: if true;
      allow delete: if isFirebaseAdmin();
    }

    // ─── MENU ─────────────────────────────────────────────────────────────────
    match /menu/{itemId} {
      allow read: if true;
      allow create, update, delete: if isFirebaseAdmin();
    }

    // ─── CATEGORIES ───────────────────────────────────────────────────────────
    match /categories/{catId} {
      allow read: if true;
      allow create, update, delete: if isFirebaseAdmin();
    }

    // ─── BANNERS ──────────────────────────────────────────────────────────────
    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isFirebaseAdmin();
    }

    // ─── SETTINGS ─────────────────────────────────────────────────────────────
    match /settings/auth {
      allow read: if isFirebaseAdmin();
      allow create, update, delete: if isFirebaseAdmin();
    }
    match /settings/{docId} {
      allow read: if true;
      allow create, update, delete: if isFirebaseAdmin();
    }

    // ─── ADMINS ───────────────────────────────────────────────────────────────
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ─── CUSTOMERS ────────────────────────────────────────────────────────────
    match /customers/{customerId} {
      allow read: if isFirebaseAdmin()
        || (request.auth != null
          && request.auth.token.phone_number == customerId);
      allow create: if request.resource.data.keys().hasAll(['phone'])
        && isValidPhone(request.resource.data.phone)
        && request.resource.data.phone == customerId;
      allow update: if isFirebaseAdmin()
        || (request.auth != null
          && request.auth.token.phone_number == customerId);
      allow delete: if isFirebaseAdmin();
    }

    // ─── STAMPS ───────────────────────────────────────────────────────────────
match /stamps/{customerId} {
  allow read: if true;
  allow create, update: if true;
  allow delete: if isFirebaseAdmin();
}

    // ─── RATINGS ──────────────────────────────────────────────────────────────
    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['orderId','itemId','star','createdAt'])
        && request.resource.data.star is int
        && request.resource.data.star >= 1
        && request.resource.data.star <= 5;
      allow update: if isFirebaseAdmin();
      allow delete: if isFirebaseAdmin();
    }

    // ─── REWARDS CATALOG ──────────────────────────────────────────────────────
    match /rewards/{rewardId} {
      allow read: if true;
      allow create, update, delete: if isFirebaseAdmin();
    }

    // ─── REWARD REDEMPTIONS ───────────────────────────────────────────────────
    match /rewardRedemptions/{docId} {
      allow read: if isFirebaseAdmin()
        || (request.auth != null
          && request.auth.token.phone_number != null
          && resource.data.phone == request.auth.token.phone_number)
        || (request.auth != null
          && request.auth.uid != null
          && resource.data.lineUserId == request.auth.uid);
      allow create: if true;
      allow update: if isFirebaseAdmin();
      allow delete: if false;
    }

    // ─── PICKUP LOCATIONS ─────────────────────────────────────────────────────
    match /pickupLocations/{locId} {
      allow read: if true;
      allow create, update, delete: if isFirebaseAdmin();
    }

    // ─── LINE USERS ───────────────────────────────────────────────────────────
    match /lineUsers/{userId} {
      allow read: if isFirebaseAdmin();
      allow write: if false;
    }

    // ─── LINE PHONE MAP ───────────────────────────────────────────────────────
    match /linePhoneMap/{phone} {
      allow read: if isFirebaseAdmin();
      allow write: if false;
    }

    // ─── PUSH SUBSCRIPTIONS ───────────────────────────────────────────────────
    match /pushSubscriptions/{id} {
      allow read: if isFirebaseAdmin();
      allow create, update: if true;
      allow delete: if isFirebaseAdmin();
    }

    // ─── PUSH QUEUE ───────────────────────────────────────────────────────────
    match /pushQueue/{docId} {
      allow read: if isFirebaseAdmin();
      allow write: if false;
    }

    // ─── LINE QUEUE ───────────────────────────────────────────────────────────
    match /lineQueue/{docId} {
      allow read: if isFirebaseAdmin();
      allow write: if true;
    }

    // ─── INTERNAL — server-only ───────────────────────────────────────────────
    match /rateLimits/{docId} {
      allow read, write: if false;
    }
    match /stats_daily/{docId} {
      allow read: if isFirebaseAdmin();
      allow write: if false;
    }
    match /stats_menu/{docId} {
      allow read: if isFirebaseAdmin();
      allow write: if false;
    }

    // 🚫 ปิดทุกอย่างที่ไม่ได้กำหนด
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
